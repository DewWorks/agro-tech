generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  OPERATOR
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   String[] @default(["CRM"]) // Módulos ativos para esta organização

  branches Branch[]
  users    User[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  city           String
  state          String
  cnpj           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  users          User[]
  userBranches   UserBranch[]
  producers      Producer[]
  properties     Property[]
  documents      Document[]
  documentAlerts DocumentAlert[]
  documentTemplates DocumentTemplate[]
  generatedForms GeneratedForm[]
  landUses       LandUse[]
  improvements   Improvement[]
  livestocks     Livestock[]
  machineries    Machinery[]
  serviceDemands ServiceDemand[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("branches")
}

model User {
  id             String   @id // UUID reference to Supabase auth.users
  organizationId String?
  email          String   @unique
  fullName       String?
  role           Role     @default(OPERATOR) // Global role (e.g. OWNER has access to everything)
  isActive       Boolean  @default(true)
  avatarUrl      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userBranches UserBranch[]
  branch       Branch?       @relation(fields: [branchId], references: [id])
  branchId     String?
  createdDemands   ServiceDemand[]        @relation("DemandCreator")
  assignedDemands  ServiceDemand[]        @relation("DemandAssignee")
  demandHistories  ServiceDemandHistory[] @relation("DemandHistoryUser")

  @@index([organizationId])
  @@index([branchId])
  @@map("users")
}

model UserBranch {
  userId   String
  branchId String
  role     Role     @default(OPERATOR) // Branch-specific role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

