model Producer {
  id             String       @id @default(uuid())
  branchId       String
  type           ProducerType
  document       String       // CPF ou CNPJ (apenas números)
  name           String
  email          String?
  phone          String?
  
  // Dados de Pessoa Física
  civilStatus    CivilStatus?
  marriageRegime MarriageRegime?
  spouseName     String?
  spouseCpf      String?

  // Representante Legal (Para PJ)
  representativeCpf String?

  // Qualificação
  dapCafNumber   String?
  qualification  Qualification?
  profession     String?
  nationality    String?
  rg             String?
  rgIssuer       String?

  // Dados Bancários
  bankName        String?
  bankAgency      String?
  bankAccount     String?
  bankAccountType String?   // "CORRENTE" | "POUPANCA"

  // Dados Pessoais Expandidos
  birthDate       DateTime?
  naturalness     String?
  educationLevel  String?
  producerSize    ProducerSize?

  // Cônjuge Expandido
  spouseRg              String?
  spouseRgIssuer        String?
  spouseNationality     String?
  spouseEducationLevel  String?

  // Endereço
  addressStreet       String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZipcode      String?
  
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      // ID do User que criou
  updatedBy      String?      // ID do User que atualizou

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  properties     ProducerProperty[]
  documents      Document[]
  documentAlerts DocumentAlert[]
  serviceDemands ServiceDemand[]

  // Restrição: O mesmo CPF/CNPJ não pode existir duas vezes na mesma filial
  @@unique([branchId, document])
  @@index([branchId])
  @@index([branchId, isActive])
  @@index([name])
  @@map("producers")
  
  generatedForms GeneratedForm[]
}

model Property {
  id             String       @id @default(uuid())
  branchId       String
  name               String
  propertyName       String?
  registrationNumber String?
  registryOffice     String?
  city               String?
  state              String?
  
  // Documentos Regulares
  car            String?
  ccir           String?
  itr            String?
  
  // Áreas (em Hectares)
  totalArea      Float        @default(0)
  productiveArea Float        @default(0)
  pastureArea    Float        @default(0)
  preserveArea   Float        @default(0)

  explorationActivity String?

  // Geolocalização
  latitude       Float?
  longitude      Float?

  // Indicadores de Propriedade
  consolidatedArea        Float?
  classification          PropertyClassification?
  ruralModules            Float?
  neighborhood            String?
  comarca                 String?
  accessRoute             String?  @db.Text
  isProven                Boolean  @default(false)
  hasLien                 Boolean  @default(false)
  isBorderProperty        Boolean  @default(false)
  hasInsurance            Boolean  @default(false)
  
  seizureStatus           SeizureStatus?
  financialStatus         PropertyFinancialStatus?
  propertyStatus          PropertyStatus? @default(QUITADA) @map("property_status")
  condominiumType         CondominiumType?
  conservationState       ConservationState?
  
  // Avaliação da Terra Nua (VTN Nativo)
  vtnValuePerHa           Float?          @map("vtn_value_per_ha")
  totalVtnAmount          Float?          @map("total_vtn_amount")

  // Limites e Confrontações Perimétricas (Nativo)
  confrontantNorth        String?         @map("confrontant_north")
  confrontantSouth        String?         @map("confrontant_south")
  confrontantEast         String?         @map("confrontant_east")
  confrontantWest         String?         @map("confrontant_west")

  confrontants            Json? // { norte, sul, leste, oeste }

  // Campos Dinâmicos (JSONB no Postgres)
  improvements   Json?        // @deprecated - migrando para relacionais
  livestock      Json?        // @deprecated - migrando para relacionais
  possessionData Json?        // Dados de Posse
  
  // Tabelas Mini-ERP
  landUses       LandUse[]
  improvementsList Improvement[]
  livestockList  Livestock[]
  machineries    Machinery[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      // ID do User que criou
  updatedBy      String?      // ID do User que atualizou

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  producers      ProducerProperty[]
  documents      Document[]
  serviceDemands ServiceDemand[]

  @@index([branchId])
  @@index([branchId, name])
  @@index([city, state])
  @@map("properties")
  
  generatedForms GeneratedForm[]
}

enum OwnershipType {
  PROPRIETARIO
  ARRENDATARIO
  MEEIRO
  COMODATARIO
  CONDOMINO
  PARCEIRO
}

model ProducerProperty {
  producerId             String
  propertyId             String
  ownershipType          OwnershipType
  explorationPercentage  Float         @default(100.0) // 0 a 100%
  contractEndDate        DateTime?     // Para arrendatários/meeiros
  
  // Campos Condicionais para Arrendamento / Parceria / Comodato / Meeiro
  landlordName           String?       @map("landlord_name")
  landlordDocument       String?       @map("landlord_document")
  contractType           String?       @map("contract_type")
  contractStartDate      DateTime?     @map("contract_start_date")
  exploredAreaHa         Float?        @map("explored_area_ha")

  producer               Producer      @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property               Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt              DateTime      @default(now())

  @@id([producerId, propertyId])
  @@index([propertyId])
  @@index([producerId])
  @@map("producer_properties")
}

model LandUse {
  id            String       @id @default(uuid())
  branchId      String       @map("branch_id")
  propertyId    String
  type          LandUseType
  characteristic String?
  unit          String       @default("ha")
  quantity      Float        @default(0)
  unitValue     Float        @default(0)
  observation   String?

  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId])
  @@index([branchId])
  @@map("land_uses")
}

model Improvement {
  id                  String       @id @default(uuid())
  branchId            String       @map("branch_id")
  propertyId          String
  specification       String
  unit                String       @default("m²")
  quantity            Float        @default(0)
  unitValue           Float        @default(0)
  observation         String?
  isArtificialPasture Boolean      @default(false) @map("is_artificial_pasture")

  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId])
  @@index([branchId])
  @@map("improvements")
}

model Livestock {
  id                  String            @id @default(uuid())
  branchId            String            @map("branch_id")
  propertyId          String
  species             LivestockSpecies
  category            LivestockCategory
  purpose             String?
  breed               String?
  quantity            Int               @default(0)
  ageMonths           Int?
  avgWeightKg         Float?
  unitValue           Float             @default(0)
  observation         String?
  brandingType        String?           @map("branding_type")
  brandingLocation    String?           @map("branding_location")
  categoryBB          AnimalCategoryBB? @map("category_bb")
  purposeBB           AnimalPurposeBB?  @map("purpose_bb")

  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([propertyId])
  @@index([propertyId, species])
  @@index([branchId])
  @@map("livestock")
}

model Machinery {
  id                      String   @id @default(uuid())
  branchId                String   @map("branch_id")
  propertyId              String
  specification           String
  brand                   String?
  model                   String?
  powerCapacity           String?
  year                    Int?
  chassisSerial           String?
  participationPercent    Float?
  value                   Float    @default(0)
  hasLien                 Boolean  @default(false)
  lienInstitution         String?

  property                Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  branch                  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([propertyId])
  @@index([branchId])
  @@map("machineries")
}

