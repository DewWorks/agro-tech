generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  OPERATOR
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   String[] @default(["CRM"]) // Módulos ativos para esta organização

  branches Branch[]
  users    User[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  city           String
  state          String
  cnpj           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  users          User[]
  userBranches   UserBranch[]
  producers      Producer[]
  properties     Property[]
  documents      Document[]
  documentAlerts DocumentAlert[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("branches")
}

model User {
  id             String   @id // UUID reference to Supabase auth.users
  organizationId String?
  email          String   @unique
  fullName       String?
  role           Role     @default(OPERATOR) // Global role (e.g. OWNER has access to everything)
  isActive       Boolean  @default(true)
  avatarUrl      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userBranches UserBranch[]
  branch       Branch?       @relation(fields: [branchId], references: [id])
  branchId     String?

  @@map("users")
}

model UserBranch {
  userId   String
  branchId String
  role     Role     @default(OPERATOR) // Branch-specific role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// ----------------------------------------------------------------------
// MÓDULO CRM E CADASTRO ÚNICO
// ----------------------------------------------------------------------

enum ProducerType {
  PF
  PJ
}

enum CivilStatus {
  SOLTEIRO
  CASADO
  SEPARADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}

enum MarriageRegime {
  COMUNHAO_PARCIAL
  COMUNHAO_UNIVERSAL
  SEPARACAO_TOTAL
  SEPARACAO_OBRIGATORIA
  PARTICIPACAO_FINAL
}

model Producer {
  id             String       @id @default(uuid())
  branchId       String
  type           ProducerType
  document       String       // CPF ou CNPJ (apenas números)
  name           String
  email          String?
  phone          String?
  
  // Dados de Pessoa Física
  civilStatus    CivilStatus?
  marriageRegime MarriageRegime?
  spouseName     String?
  spouseCpf      String?

  // Qualificação
  dapCafNumber   String?
  
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      // ID do User que criou
  updatedBy      String?      // ID do User que atualizou

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  properties     ProducerProperty[]
  documents      Document[]
  documentAlerts DocumentAlert[]

  // Restrição: O mesmo CPF/CNPJ não pode existir duas vezes na mesma filial
  @@unique([branchId, document])
  @@map("producers")
}

model Property {
  id             String       @id @default(uuid())
  branchId       String
  name           String
  
  // Documentos Regulares
  car            String?
  ccir           String?
  itr            String?
  
  // Áreas (em Hectares)
  totalArea      Float        @default(0)
  productiveArea Float        @default(0)
  pastureArea    Float        @default(0)
  preserveArea   Float        @default(0)

  // Geolocalização
  latitude       Float?
  longitude      Float?

  // Campos Dinâmicos (JSONB no Postgres)
  improvements   Json?        // Benfeitorias
  livestock      Json?        // Rebanho
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      // ID do User que criou
  updatedBy      String?      // ID do User que atualizou

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  producers      ProducerProperty[]
  documents      Document[]

  @@map("properties")
}

enum OwnershipType {
  PROPRIETARIO
  ARRENDATARIO
  MEEIRO
  COMODATARIO
  CONDOMINO
}

model ProducerProperty {
  producerId             String
  propertyId             String
  ownershipType          OwnershipType
  explorationPercentage  Float         @default(100.0) // 0 a 100%
  contractEndDate        DateTime?     // Para arrendatários/meeiros
  
  producer               Producer      @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property               Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt              DateTime      @default(now())

  @@id([producerId, propertyId])
  @@map("producer_properties")
}

// ----------------------------------------------------------------------
// MÓDULO GED - GESTÃO ELETRÔNICA DE DOCUMENTOS
// ----------------------------------------------------------------------

enum DocumentType {
  MATRICULA
  CAR
  CCIR
  ITR
  RG_CPF
  CERTIDAO_CASAMENTO
  CONTRATO_ARRENDAMENTO
  OUTORGA_AGUA
  CND_IBAMA
  CND_FEDERAL
  DAP_CAF
  LAUDO_TECNICO
  OUTROS
}

enum ComplianceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentAlertLevel {
  EXPIRING_60
  EXPIRING_30
  EXPIRING_7
  EXPIRED
}

model Document {
  id               String           @id @default(uuid())
  branchId         String
  producerId       String
  propertyId       String?
  documentType     DocumentType
  fileName         String
  fileSize         Int
  mimeType         String
  storagePath      String           @unique
  issueDate        DateTime?
  expirationDate   DateTime?
  cropYear         String?
  complianceStatus ComplianceStatus @default(PENDING)
  rejectionReason  String?
  metadataPayload  Json?

  // Herança & Versionamento
  isInherited      Boolean          @default(false)
  inheritedFromId  String?
  isSuperseded     Boolean          @default(false)
  isArchived       Boolean          @default(false)

  createdBy        String?
  updatedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relações
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  producer         Producer         @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property         Property?        @relation(fields: [propertyId], references: [id])
  inheritedFrom    Document?        @relation("DocumentInheritance", fields: [inheritedFromId], references: [id])
  inheritedDocs    Document[]       @relation("DocumentInheritance")
  alerts           DocumentAlert[]

  @@index([branchId, producerId])
  @@index([branchId, documentType])
  @@index([expirationDate])
  @@map("documents")
}

model DocumentAlert {
  id               String             @id @default(uuid())
  branchId         String
  documentId       String
  producerId       String
  alertLevel       DocumentAlertLevel
  daysToExpiration Int
  isResolved       Boolean            @default(false)
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())

  // Relações
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  producer         Producer           @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([branchId, isResolved])
  @@index([producerId])
  @@map("document_alerts")
}

// ----------------------------------------------------------------------
// GESTÃO DE MÓDULOS GLOBAIS
// ----------------------------------------------------------------------

model SystemModule {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'CRM', 'GED', 'CREDITO'
  name        String   // e.g. 'CRM Agronegócio'
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_modules")
}
