generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  OPERATOR
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  users    User[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  city           String
  state          String
  cnpj           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  userBranches   UserBranch[]
  producers      Producer[]
  properties     Property[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("branches")
}

model User {
  id             String   @id // UUID reference to Supabase auth.users
  organizationId String?
  email          String   @unique
  fullName       String?
  role           Role     @default(OPERATOR) // Global role (e.g. OWNER has access to everything)
  isActive       Boolean  @default(true)
  avatarUrl      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userBranches UserBranch[]
  branch       Branch?       @relation(fields: [branchId], references: [id])
  branchId     String?

  @@map("users")
}

model UserBranch {
  userId   String
  branchId String
  role     Role     @default(OPERATOR) // Branch-specific role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// ----------------------------------------------------------------------
// MÓDULO CRM E CADASTRO ÚNICO
// ----------------------------------------------------------------------

enum ProducerType {
  PF
  PJ
}

enum CivilStatus {
  SOLTEIRO
  CASADO
  SEPARADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}

enum MarriageRegime {
  COMUNHAO_PARCIAL
  COMUNHAO_UNIVERSAL
  SEPARACAO_TOTAL
  SEPARACAO_OBRIGATORIA
  PARTICIPACAO_FINAL
}

model Producer {
  id             String       @id @default(uuid())
  branchId       String
  type           ProducerType
  document       String       // CPF ou CNPJ (apenas números)
  name           String
  email          String?
  phone          String?
  
  // Dados de Pessoa Física
  civilStatus    CivilStatus?
  marriageRegime MarriageRegime?
  spouseName     String?
  spouseCpf      String?

  // Qualificação
  dapCafNumber   String?
  
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      // ID do User que criou
  updatedBy      String?      // ID do User que atualizou

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  properties     ProducerProperty[]

  // Restrição: O mesmo CPF/CNPJ não pode existir duas vezes na mesma filial
  @@unique([branchId, document])
  @@map("producers")
}

model Property {
  id             String       @id @default(uuid())
  branchId       String
  name           String
  
  // Documentos Regulares
  car            String?
  ccir           String?
  itr            String?
  
  // Áreas (em Hectares)
  totalArea      Float        @default(0)
  productiveArea Float        @default(0)
  pastureArea    Float        @default(0)
  preserveArea   Float        @default(0)

  // Geolocalização
  latitude       Float?
  longitude      Float?

  // Campos Dinâmicos (JSONB no Postgres)
  improvements   Json?        // Benfeitorias
  livestock      Json?        // Rebanho
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      // ID do User que criou
  updatedBy      String?      // ID do User que atualizou

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  producers      ProducerProperty[]

  @@map("properties")
}

enum OwnershipType {
  PROPRIETARIO
  ARRENDATARIO
  MEEIRO
  COMODATARIO
  CONDOMINO
}

model ProducerProperty {
  producerId             String
  propertyId             String
  ownershipType          OwnershipType
  explorationPercentage  Float         @default(100.0) // 0 a 100%
  contractEndDate        DateTime?     // Para arrendatários/meeiros
  
  producer               Producer      @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property               Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt              DateTime      @default(now())

  @@id([producerId, propertyId])
  @@map("producer_properties")
}
