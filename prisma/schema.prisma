enum ComplianceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentAlertLevel {
  EXPIRING_60
  EXPIRING_30
  EXPIRING_7
  EXPIRED
}

model Document {
  id               String           @id @default(uuid())
  branchId         String
  producerId       String
  propertyId       String?
  documentType     DocumentType
  fileName         String
  fileSize         Int
  mimeType         String
  storagePath      String
  issueDate        DateTime?
  expirationDate   DateTime?
  cropYear         String?
  complianceStatus ComplianceStatus @default(PENDING)
  rejectionReason  String?
  metadataPayload  Json?

  // Herança & Versionamento
  isInherited      Boolean          @default(false)
  inheritedFromId  String?
  isSuperseded     Boolean          @default(false)
  isArchived       Boolean          @default(false)

  createdBy        String?
  updatedBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relações
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  producer         Producer         @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property         Property?        @relation(fields: [propertyId], references: [id])
  inheritedFrom    Document?        @relation("DocumentInheritance", fields: [inheritedFromId], references: [id])
  inheritedDocs    Document[]       @relation("DocumentInheritance")
  alerts           DocumentAlert[]
  checklistItems   DemandChecklistItem[]
  primaryDemands   ServiceDemand[]  @relation("DemandPrimaryDocument")

  @@index([branchId, producerId])
  @@index([branchId, documentType])
  @@index([branchId, complianceStatus])
  @@index([propertyId])
  @@index([expirationDate])
  @@index([storagePath])
  @@index([isArchived, isSuperseded])
  @@map("documents")
}

model DocumentAlert {
  id               String             @id @default(uuid())
  branchId         String
  documentId       String
  producerId       String
  alertLevel       DocumentAlertLevel
  daysToExpiration Int
  isResolved       Boolean            @default(false)
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())

  // Relações
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  producer         Producer           @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@index([branchId, isResolved])
  @@index([producerId])
  @@map("document_alerts")
}

// ----------------------------------------------------------------------
// GESTÃO DE MÓDULOS GLOBAIS
// ----------------------------------------------------------------------

model SystemModule {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'CRM', 'GED', 'CREDITO'
  name        String   // e.g. 'CRM Agronegócio'
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_modules")
}

// ----------------------------------------------------------------------
// MÓDULO AUTOMAÇÃO LEGAL E DOSSIÊ
// ----------------------------------------------------------------------

model DocumentTemplate {
  id          String   @id @default(uuid())
  branchId    String?  @map("branch_id")
  code        String   @unique
  title       String
  description String
  contentHtml String   @db.Text
  schemaJson  Json
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("document_templates")
}

model GeneratedForm {
  id                String   @id @default(uuid())
  branchId          String   @map("branch_id")
  producerId        String   @map("producer_id")
  propertyId        String?  @map("property_id")
  templateCode      String   @map("template_code")
  templateVersion   Int      @map("template_version")
  payloadSnapshot   Json     @map("payload_snapshot")
  storagePdfPath    String?  @map("storage_pdf_path")
  sha256Hash        String?  @map("sha256_hash")
  createdAt         DateTime @default(now()) @map("created_at")

  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  producer          Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@map("generated_forms")
}

// ----------------------------------------------------------------------
// MÓDULO DE SERVIÇOS E DEMANDAS (CRM DE ATENDIMENTO RURAL)
// ----------------------------------------------------------------------

enum RuralServiceType {
  PROJETO_CUSTEIO              // Projeto de Custeio Agrícola / Pecuário
  PROJETO_INVESTIMENTO         // Projeto de Investimento (Máquinas, Solo, Benfeitorias)
  LIMITE_CREDITO               // Limite de Crédito / Limite Técnico
  PRORROGACAO_DIVIDAS          // Prorrogação de Dívidas / Alongamento
  CADASTRO_AMBIENTAL_RURAL     // Cadastro Ambiental Rural (CAR)
  LEVANTAMENTO_TOPOGRAFICO     // Levantamento Topográfico / Georreferenciamento
  LAUDO_TECNICO                // Laudo Técnico de Avaliação Patrimonial
  ORCAMENTO_SERVICOS           // Orçamento de Serviços
  VISITA_TECNICA               // Visita Técnica de Campo
  OUTORGA_LICENCA_AMBIENTAL    // Outorga / DUI / Licença Ambiental
  OUTROS                       // Outros Serviços Rurais
}

enum DemandStatus {
  SOLICITADO                   // Serviço Solicitado (Triagem/Entrada)
  EM_EXECUCAO                  // Em Execução (Elaboração técnica)
  AGUARDANDO_DOCUMENTACAO      // Aguardando Documentação (Com lista de pendências)
  CONCLUIDO                    // Concluído (Finalizado/Entregue)
  CANCELADO                    // Cancelado (Arquivado pelo cliente)
}

enum DemandPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model ServiceDemand {
  id                    String            @id @default(uuid())
  branchId              String            @map("branch_id")
  createdById           String            @map("created_by_id")
  assignedToId          String?           @map("assigned_to_id")
  producerId            String            @map("producer_id")
  propertyId            String?           @map("property_id")
  proposalId            String?           @map("proposal_id")
  documentId            String?           @map("document_id")
  responsibleName       String?           @map("responsible_name")

  serviceType           RuralServiceType  @map("service_type")
  customServiceType     String?           @map("custom_service_type")
  status                DemandStatus      @default(SOLICITADO)
  priority              DemandPriority    @default(MEDIA)

  description           String?           @db.Text @map("description")
  notes                 String?           @db.Text @map("notes")

  // Controle de Prazos
  requestDate           DateTime          @default(now()) @map("request_date")
  startDate             DateTime?         @map("start_date")
  estimatedDeliveryDate DateTime?         @map("estimated_delivery_date")
  completionDate        DateTime?         @map("completion_date")

  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  // Relacionamentos
  branch                Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  creator               User              @relation("DemandCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo            User?             @relation("DemandAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  producer              Producer          @relation(fields: [producerId], references: [id], onDelete: Cascade)
  property              Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  document              Document?         @relation("DemandPrimaryDocument", fields: [documentId], references: [id], onDelete: SetNull)
  checklistItems        DemandChecklistItem[]
  history               ServiceDemandHistory[]

  @@index([branchId, status])
  @@index([branchId, serviceType])
  @@index([createdById])
  @@index([assignedToId])
  @@index([producerId])
  @@index([propertyId])
  @@index([proposalId])
  @@map("service_demands")
}

model ServiceDemandHistory {
  id                    String            @id @default(uuid())
  demandId              String            @map("demand_id")
  userId                String            @map("user_id")
  fromStatus            DemandStatus?     @map("from_status")
  toStatus              DemandStatus      @map("to_status")
  notes                 String?           @db.Text @map("notes")
  createdAt             DateTime          @default(now()) @map("created_at")

  demand                ServiceDemand     @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user                  User              @relation("DemandHistoryUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([demandId, createdAt])
  @@index([userId])
  @@map("service_demand_histories")
}

model DemandChecklistItem {
  id               String           @id @default(uuid())
  demandId         String           @map("demand_id")
  title            String
  documentType     DocumentType?    @map("document_type")
  documentId       String?          @map("document_id")
  isRequired       Boolean          @default(true) @map("is_required")
  isDelivered      Boolean          @default(false) @map("is_delivered")
  deliveredAt      DateTime?        @map("delivered_at")
  notes            String?

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  demand           ServiceDemand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  document         Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([demandId])
  @@map("demand_checklist_items")
}
